	set duration keypress
	set description "A sketchpad containing the instructions for the participant"
	draw textline center=1 color=white font_bold=yes font_family=mono font_italic=no font_size=26 html=yes show_if=True text="Entre chaque fixation, des lettres vous seront présentés  " x=20 y=-230 z_index=0
	draw textline center=1 color=white font_bold=yes font_family=mono font_italic=no font_size=45 html=yes show_if=True text=F x=0 y=0 z_index=0
	draw textline center=1 color=white font_bold=yes font_family=mono font_italic=no font_size=30 html=yes show_if=True text="Appuyer sur une touche pour passer." x=0 y=352 z_index=0

