define inline_script prepa_trigger
	set description "Exécute du code Python"
	___run__
	import pyxid2
	
	dev = pyxid2.get_xid_devices()[0]
	dev.set_pulse_duration(50)
	__end__
	set _prepare ""

define sketchpad presentation
	set start_response_interval no
	set duration 0
	set description "Displays stimuli"
	draw textline center=1 color=white font_bold=yes font_family=mono font_italic=no font_size=45 html=yes show_if=True text="[valeur]" x=0 y=0 z_index=0

define reset_feedback reset_feedback
	set description "Resets the feedback variables, such as 'avg_rt' and 'acc'"

define form_text_input test_mode
	set timeout infinite
	set spacing 10
	set rows "1;1;6"
	set only_render no
	set margins "50;50;50;50"
	set form_var test_mode
	set form_title test
	set form_question "Test mode :"
	set description "A simple text input form"
	set cols 1
	set _theme gray
	widget 0 0 1 1 label text="{form_title}"
	widget 0 1 1 1 label center=no text="{form_question}"
	widget 0 2 1 1 text_input focus=yes return_accepts=yes stub="" var="{form_var}"


define inline_script trigger
	set description "Exécute du code Python"
	___run__
	if copieTable[count] == 1 :
	    dev.activate_line(lines = 2)
	    
	elif copieTable[count] == 0 :
	    dev.activate_line(lines = 3)
	    
	else : 
	    print("Erreur de variable de reponse ou codage du tableau")
	__end__
	set _prepare ""

define inline_script trigger_rep
	set description "Exécute du code Python"
	___run__
	if correct_response == None :
	    if response_keyboard_response == "num_0" :
	        dev.activate_line(lines = 12)
	    else :
	        dev.activate_line(lines = 13)
	
	elif correct_response == "num_0":
	    if response_keyboard_response == "num_0" :
	        dev.activate_line(lines = 14)
	    else :
	        dev.activate_line(lines = 15)
	__end__
	set _prepare ""

define inline_script trigger_stop
	set description "Exécute du code Python"
	___run__
	del dev
	 
	__end__
	set _prepare ""

