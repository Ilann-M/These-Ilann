set width 1920
set title "1-Back"
set subject_parity even
set subject_nr 0
set start Expe
set sound_sample_size -16
set sound_freq 48000
set sound_channels 2
set sound_buf_size 1024
set sampler_backend psycho
set round_decimals 2
set psychopy_screen 1
set mouse_backend psycho
set keyboard_backend psycho
set height 1080
set fullscreen no
set form_clicks no
set foreground white
set font_underline no
set font_size 26
set font_italic False
set font_family mono
set font_bold False
set experiment_path "C:\\Users\\mahou\\Desktop"
set disable_garbage_collection False
set description "A template containing a practice and an experimental phase"
set color_backend psycho
set clock_backend psycho
set canvas_backend psycho
set background "#3d3846"

define inline_script Exe
	set description "Exécute du code Python"
	set _run ""
	___prepare__
	var.valeur = testArray[count]
	
	if copieTable[count] == 1 : 
	    correct_response = "num_0" 
	
	else : correct_response = None
	__end__

define sequence Expe
	set flush_keyboard yes
	set description "The main sequence of the experiment"
	run test_mode True
	run Id_participant "[test_mode] != \"y\""
	run consigne_passation "[test_mode] != \"y\""
	run consigne_fix "[test_mode] != \"y\""
	run consigne_1 "[test_mode] != \"y\""
	run consigne_2 "[test_mode] != \"y\""
	run consigne_ex1 "[test_mode] != \"y\""
	run fix_ex1 "[test_mode] != \"y\""
	run consigne_ex2 "[test_mode] != \"y\""
	run fix_ex2 "[test_mode] != \"y\""
	run consigne_ex3 "[test_mode] != \"y\""
	run fix_ex3 "[test_mode] != \"y\""
	run consigne_ex4 "[test_mode] != \"y\""
	run consigne_3 "[test_mode] != \"y\""
	run consigne_4 "[test_mode] != \"y\""
	run consigne_lancement "[test_mode] != \"y\""
	run prepa_trigger True
	run experimental_loop True
	run trigger_stop True
	run end_of_experiment "[test_mode] != \"y\""

define form_text_input Id_participant
	set timeout infinite
	set spacing 10
	set rows "1;1;6"
	set only_render no
	set margins "50;50;50;50"
	set form_var ID
	set form_title Identifiant
	set form_question "Identifiant participant :"
	set description "A simple text input form"
	set cols 1
	set _theme gray
	widget 0 0 1 1 label text="{form_title}"
	widget 0 1 1 1 label center=no text="{form_question}"
	widget 0 2 1 1 text_input focus=yes return_accepts=yes stub="" var="{form_var}"


define inline_script Init
	set description "Exécute du code Python"
	set _run ""
	___prepare__
	import random
	
	var.allowedLetters = ["B","C","D","E","F","G","H","I","J","L","M","N","P","R","S","T","U","V","W","Y","Z"]
	
	var.testLength = 70*2
	testRate = 0.3
	testCount = int(testLength*testRate)
	fakeTests = testLength - testCount - 4
	testArray = [0]*fakeTests + [1]*testCount
	random.shuffle(testArray)
	testArray = [0,0] + testArray + [0,0]
	
	var.copieTable = testArray[::-1].copy()
	var.nBack = 1
	__end__

define inline_script Tableau
	set description "Exécute du code Python"
	set _run ""
	___prepare__
	import random
	
	def setRandomLetter(testArray, idx):
	    letter = random.choice(allowedLetters)
	    prevIndex = idx - var.nBack
	    if prevIndex < 0:
	        testArray[idx] = letter
	        return
	    prevLetter = testArray[prevIndex]
	    while letter == prevLetter:
	        letter = random.choice(allowedLetters)
	    testArray[idx] = letter
	
	def putSubsequentLetter(testArray, idx, letter = None):
	    if letter is None:
	        allowedCopy = allowedLetters.copy()
	#        if idx >= 1:
	#            back1 = testArray[idx-1]
	#            allowedCopy.remove(back1)
	        if idx > 1 :
	            back1 = testArray[idx-2]
	            allowedCopy.remove(back1)
	        letter = random.choice(allowedCopy)
	    testArray[idx] = letter
	    nextIndex = idx + var.nBack
	    if nextIndex > len(testArray) -1:
	        return
	    nextValue = testArray[nextIndex]
	    testArray[nextIndex] = letter
	    if nextValue == 1:
	        putSubsequentLetter(testArray, nextIndex, letter)
	
	for idx, val in enumerate(testArray):
	    if val == 0:
	        setRandomLetter(testArray, idx)
	    elif val == 1:
	        putSubsequentLetter(testArray, idx)
	
	testArray = testArray[::-1]
	__end__

